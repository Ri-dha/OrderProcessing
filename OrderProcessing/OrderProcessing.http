@OrderProcessing_HostAddress = http://localhost:5203

### Create Single Product
POST {{OrderProcessing_HostAddress}}/api/products
Content-Type: application/json

{
  "name": "Gaming Mouse",
  "sku": "MSE-001",
  "price": 49.99,
  "initialStock": 20
}

### Create Many Products
POST {{OrderProcessing_HostAddress}}/api/products/bulk
Content-Type: application/json

{
  "products": [
    { "name": "Keyboard", "sku": "KB-001", "price": 99.99, "initialStock": 10 },
    { "name": "Headset", "sku": "HS-001", "price": 79.99, "initialStock": 15 }
  ]
}

### Get Products
GET {{OrderProcessing_HostAddress}}/api/products

### Create Order (replace productId)
POST {{OrderProcessing_HostAddress}}/api/orders
Content-Type: application/json

{
  "items": [
    {
      "productId": "00000000-0000-0000-0000-000000000000",
      "quantity": 1
    }
  ]
}

### Initiate Payment (replace order id)
POST {{OrderProcessing_HostAddress}}/api/orders/00000000-0000-0000-0000-000000000000/pay/initiate
Content-Type: application/json

{
  "cardNumber": "4111111111111111",
  "expiryDate": "12/30",
  "cvc": "123"
}

### Verify Payment (replace order id and token)
POST {{OrderProcessing_HostAddress}}/api/orders/00000000-0000-0000-0000-000000000000/pay/verify
Content-Type: application/json

{
  "verificationToken": "REPLACE_TOKEN",
  "idempotencyKey": "pay-verify-1"
}

### Update Product (replace product id)
PUT {{OrderProcessing_HostAddress}}/api/products/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "name": "Gaming Mouse Pro",
  "sku": "MSE-001-PRO",
  "price": 59.99,
  "stock": 25,
  "isDeleted": false
}
